# ---- Core (phase 1) ----------------------------------------------------
# development | test | production
NODE_ENV=development
# Port the API listens on
PORT=3000
# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sport_dev
# Use TLS to Postgres. Defaults to true in production, false otherwise.
DATABASE_SSL=
# Comma-separated browser origins allowed to call the API (required in production)
CORS_ORIGINS=http://localhost:5173
# At least 32 random characters; signs the guest cart cookie
COOKIE_SECRET=change-me-to-32-or-more-random-characters
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---- Sign-in (Firebase) -------------------------------------------------
# Firebase project id. Without it, sign-in routes answer 503 (OK for local work).
FIREBASE_PROJECT_ID=
# Service account JSON on one line (required in production: revocation checks + account deletion)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated phones (any format) / emails that become admin when they sign in
BOOTSTRAP_ADMIN_PHONES=
BOOTSTRAP_ADMIN_EMAILS=

# ---- Phase 5+ (leave empty for now) ------------------------------------
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_BASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
