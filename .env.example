# Copy to .env for local development. Never commit real values.

# development | test | production
NODE_ENV=development
PORT=8080
# Postgres connection string (docker compose uses the value below)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sportcastle
# Comma-separated websites allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Requests per minute per IP on /v1
RATE_LIMIT_PER_MINUTE=300
# Public URL of this API (required in production; used in the OpenAPI "servers" list)
PUBLIC_BASE_URL=http://localhost:8080
