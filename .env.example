# ---- Core (phase 1) ----------------------------------------------------
# development | test | production
NODE_ENV=development
# Port the API listens on
PORT=3000
# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sport_dev
# Use TLS to Postgres. Defaults to true in production, false otherwise.
DATABASE_SSL=
# Comma-separated browser origins allowed to call the API (required in production)
CORS_ORIGINS=http://localhost:5173
# At least 32 random characters; signs the guest cart cookie
COOKIE_SECRET=change-me-to-32-or-more-random-characters
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Prefix for catalog image paths (CDN or static host), e.g. https://cdn.example.com/
ASSET_BASE_URL=/assets/

# ---- Sign-in (Firebase) -------------------------------------------------
# Firebase project id. Without it, sign-in routes answer 503 (OK for local work).
FIREBASE_PROJECT_ID=
# Service account JSON on one line (required in production: revocation checks + account deletion)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated phones (any format) / emails that become admin when they sign in
BOOTSTRAP_ADMIN_PHONES=
BOOTSTRAP_ADMIN_EMAILS=

# ---- Payments (ABA PayWay) ----------------------------------------------
# Leave merchant id + key empty to use the built-in fake provider (development only;
# test payments are approved at POST /v1/dev/payments/:tranId/approve).
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Sandbox by default; production: https://checkout.payway.com.kh
PAYWAY_BASE_URL=
# Webhook (pushback) URL registered with PayWay, e.g. https://api.example.com/v1/webhooks/payway
PAYWAY_RETURN_URL=
# Where shoppers land after card payment, e.g. https://example.com/checkout/return
PAYWAY_CONTINUE_URL=
# true = production without PayWay (only cash on pickup is offered)
PAYMENT_METHODS_CASH_ONLY=
# This API's public URL (used by the dev payment page)
PUBLIC_API_URL=http://localhost:3000

# ---- Notifications --------------------------------------------------------
# Ops alerts to a Telegram chat; customer emails through Resend. Empty = skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# ---- Background jobs ------------------------------------------------------
# Per-minute sweeper: payment checks, expiring unpaid orders, notifications, old guest bags
JOBS_ENABLED=true
