{
  "name": "sport-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Sport Castle commerce API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:int": "vitest run test/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "db:seed": "node dist/db/seed/run.js",
    "catalog:import": "node dist/db/seed/importCatalog.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.17",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
